# Copy to .env.local and fill in. Never commit real keys.

# Supabase project URL and publishable (anon) key: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Older projects show an "anon" key instead; either variable name works:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Public address of the app, used in invitation, registration and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, server-only. Lets the app email invitations through Supabase Auth.
# Without it, organisers copy the invitation link and send it themselves.
# Keep it secret: it bypasses Row Level Security. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
